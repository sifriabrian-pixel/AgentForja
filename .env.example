# Claude
ANTHROPIC_API_KEY=
# Opcionales (por defecto: claude-opus-5-5, effort low)
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=

# WhatsApp Cloud API (número de Forja)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Obligatorio en producción: sin esto el webhook rechaza todos los mensajes
WHATSAPP_APP_SECRET=
# 1 = no envía nada a Meta, solo loguea (pruebas locales)
WHATSAPP_DRY_RUN=

# Base SQLite. Tiene que estar en disco persistente, FUERA de la carpeta del
# código (en Railway: dentro del volumen montado, ej. /data/forja.sqlite).
# En producción el agente no arranca si esta ruta no está definida.
DB_PATH=

# Tokko Broker. Sin API key el catálogo se carga de fixtures/tokko-fichas.json
TOKKO_API_KEY=
TOKKO_SYNC_HOURS=6

# Derivaciones: número de WhatsApp de Alejandro (con código de país, sin +)
HANDOFF_WHATSAPP=
# Plantilla aprobada (con botón "Recibir para reenviar") para avisarle a Alejandro
# cuando no escribió al número en las últimas 24 hs. Texto en docs/plantillas-meta.md.
# Vacío = con la ventana cerrada el brief queda guardado hasta que Alejandro escriba.
HANDOFF_TEMPLATE_NAME=

# Seguimiento
# Días de cada toque, separados por coma. Hoy uno solo. Para dos: 3,7
FOLLOWUP_DAYS=5
# Plantilla aprobada por Meta. Vacío = fuera de la ventana de 24 hs no se envía nada.
FOLLOWUP_TEMPLATE_NAME=

# Pausa del agente cuando interviene una persona
HUMAN_TAKEOVER_HOURS=24

# Fase 2: ofrecer opciones de la cartera al lead
ENABLE_PROPERTY_SEARCH=false

# Cómo se presenta el agente
AGENT_IDENTITY=

PORT=3000
